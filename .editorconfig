root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 140
# Ported code keeps upstream's names and structure where that helps diffing against Swift.
ktlint_standard_property-naming = disabled
ktlint_standard_function-naming = disabled
# Byte layouts are annotated field by field, e.g. 0x01, // KK = even key
ktlint_standard_discouraged-comment-location = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,toml}]
indent_size = 2
